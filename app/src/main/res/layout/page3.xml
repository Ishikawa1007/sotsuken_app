<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 左上：もどる -->
    <Button
        android:id="@+id/button31"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="もどる"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp" />

    <!-- 右上：すすむ -->
    <Button
        android:id="@+id/button32"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="すすむ"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp" />

    <!-- 真ん中上：カメラチェック -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="カメラチェック"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/button31"
        app:layout_constraintStart_toEndOf="@+id/button31"
        app:layout_constraintEnd_toStartOf="@+id/button32"
        android:layout_marginTop="24dp"
        app:layout_constraintHorizontal_bias="0.5" />

    <!-- カメラウィンドウ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#DAD0E8"
        app:implementationMode="compatible"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <!-- 待機メッセージ -->
    <TextView
        android:id="@+id/textLoading3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="カメラをじゅんびしています...\nしばらくおまちください"
        android:gravity="center"
        android:textColor="#666666"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview"
        app:layout_constraintStart_toStartOf="@+id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview" />

</androidx.constraintlayout.widget.ConstraintLayout>
