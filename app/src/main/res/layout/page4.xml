<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 左上：もどる -->
    <Button
        android:id="@+id/button41"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="もどる"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp" />

    <!-- 右上：あそぶ -->
    <Button
        android:id="@+id/button42"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="あそぶ"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp" />

    <!-- 真ん中上：指チェック -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="指チェック"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/button41"
        app:layout_constraintStart_toEndOf="@+id/button41"
        app:layout_constraintEnd_toStartOf="@+id/button42"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_marginTop="24dp" />

    <!-- カメラウィンドウ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#DAD0E8"
        app:implementationMode="compatible"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="8:3"
        android:layout_margin="8dp" />

    <!-- MediaPipe Overlay -->
    <com.example.smarttyping.OverlayView
        android:id="@+id/overlayView4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview4"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview4"
        app:layout_constraintStart_toStartOf="@+id/cameraPreview4"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview4" />

    <!-- 待機メッセージ -->
    <TextView
        android:id="@+id/textLoading4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="カメラをじゅんびしています...\nしばらくおまちください"
        android:gravity="center"
        android:textColor="#666666"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview4"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview4"
        app:layout_constraintStart_toStartOf="@+id/cameraPreview4"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview4" />

</androidx.constraintlayout.widget.ConstraintLayout>
